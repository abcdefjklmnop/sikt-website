{
  "name": "sikt-nettside",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && tsc --noEmit -p tsconfig.functions.json",
    "build": "astro build && node scripts/finalize-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "pages:dev": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:site": "node scripts/check-build.mjs",
    "launch:check": "node scripts/launch-check.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.151.2"
  }
}
